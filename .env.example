# StudioSpace Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI (replace with your Atlas connection string in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studiospace?retryWrites=true&w=majority
MONGODB_DB_NAME=studiospace

# Better Auth & JWT Session Secrets (generate random 32+ character secrets in production)
BETTER_AUTH_SECRET=studiospace-secure-jwt-auth-secret-key-32chars-min
JWT_SECRET=studiospace-secure-jwt-auth-secret-key-32chars-min

# Base URLs for Session & CORS Coordination
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Google OAuth Credentials (create in Google Cloud Console -> APIs & Services -> Credentials)
# Authorized Redirect URI: http://localhost:5000/api/auth/callback/google
# (In production, replace http://localhost:5000 with your Render backend URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
